# OnMangeOu - backend API et workers
# Reference : specification technique maitre, section 26.
# Ce fichier ne contient AUCUNE valeur reelle. Les secrets de production vivent
# uniquement dans le gestionnaire de secrets (section 22).

# --- Execution ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=3000
API_BASE_URL=http://localhost:3000
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=/data/uploads
# MEDIA_PUBLIC_BASE_URL=https://api.example.com/api/v1/media
LOG_LEVEL=debug

# Origines autorisees pour CORS, separees par des virgules (section 22).
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Base de donnees ---------------------------------------------------------
# PostgreSQL 18 + PostGIS 3.x. Le port local 5433 evite tout conflit avec une
# instance PostgreSQL deja installee sur la machine.
DATABASE_URL=postgresql://onmangeou:onmangeou_local_only@localhost:5433/onmangeou?schema=public
SHADOW_DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Cache, verrous et files -------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Stockage objet ----------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=onmangeou-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/onmangeou-local

# --- Jetons ------------------------------------------------------------------
# Signature asymetrique ES256. Generer une paire locale avec :
#   pnpm tsx scripts/generate-jwt-keys.ts
# Les cles multilignes sont encodees en base64 pour rester sur une seule ligne.
JWT_ISSUER=https://api.onmangeou.ci
JWT_AUDIENCE=onmangeou-apps
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- OTP ---------------------------------------------------------------------
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Sel serveur du hachage des codes OTP. Obligatoire hors developpement.
OTP_PEPPER=
# En local, le code est retourne par l'API pour eviter tout envoi de SMS reel.
# INTERDIT en staging et en production.
OTP_DEV_ECHO_CODE=true

# --- Paiement ----------------------------------------------------------------
# Aucun agregateur n'est arrete (section 36). `sandbox` est un adaptateur de
# demonstration clairement identifie, jamais utilisable en production.
PAYMENT_PROVIDER=sandbox
# Secret serveur explicite requis pour le webhook de simulation (aucun débit).
PAYMENTS_SANDBOX_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Cartographie ------------------------------------------------------------
MAP_TILES_URL=
MAP_API_KEY=

# --- Notifications -----------------------------------------------------------
SMS_PROVIDER=console
SMS_SENDER_ID=OnMangeOu
# Pour activer l'envoi reel : SMS_PROVIDER=twilio, identifiants serveur uniquement.
# SMS_SENDER_ID doit etre un expediteur autorise dans votre compte Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Observabilite -----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=onmangeou-backend-api

# --- Limitation de debit -----------------------------------------------------
RATE_LIMIT_ENABLED=true
