{
  "name": "onmangeou-backend-api",
  "version": "0.1.0",
  "private": true,
  "description": "OnMangeOu - API REST, regles metier et workers",
  "license": "UNLICENSED",
  "author": "Emmanuel Kouame",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --no-experimental-require-module scripts/bundle-api.cjs && node --no-experimental-require-module dist/run.cjs",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "node --watch --enable-source-maps -r @swc-node/register src/worker.ts",
    "lint": "eslint \"{src,tests}/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"{src,tests,prisma}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:coverage": "VITEST_COVERAGE_SCOPE=unit vitest run --project unit --coverage",
    "test:coverage:unit": "VITEST_COVERAGE_SCOPE=unit vitest run --project unit --coverage",
    "test:coverage:integration": "VITEST_COVERAGE_SCOPE=integration vitest run --project integration --coverage",
    "test:coverage:all": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:status": "prisma migrate status",
    "seed": "node -r @swc-node/register prisma/seed.ts",
    "openapi:generate": "node -r @swc-node/register scripts/generate-openapi.ts",
    "keys:generate": "node -r @swc-node/register scripts/generate-jwt-keys.ts",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "prisma": {
    "seed": "node -r @swc-node/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.4",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "^12.0.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.2",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.68.0",
    "unplugin-swc": "1.5.11",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  }
}
